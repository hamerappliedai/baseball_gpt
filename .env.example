# Copy to .env and adjust. Read by docker compose, the Makefile and the pipeline.
# Postgres applies POSTGRES_USER/PASSWORD/DB only when its volume is first
# created; after changing them run `docker compose down -v` and `make build`.
POSTGRES_USER=bgpt
POSTGRES_PASSWORD=bgpt
POSTGRES_DB=baseball
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keep in step with the values above.
DATABASE_URL=postgresql://bgpt:bgpt@localhost:5432/baseball

# Read-only role the backend uses to run Claude's SQL (created by db/roles.sql).
# Pick any password; keep the URL in step with it.
READER_PASSWORD=change-me
READER_DATABASE_URL=postgresql://bgpt_reader:change-me@localhost:5432/baseball

# Phase 4 search: the sentence-transformers model used to embed player names.
# The pipeline (`make embed`) and the backend must use the same one; the backend
# falls back to plain SQL name search if they differ. Downloaded from Hugging
# Face on first use (about 90 MB; no token needed).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
